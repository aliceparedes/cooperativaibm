# ─── IBM Cloud App ID OIDC ──────────────────────────────────────────────────
# OAuth Server URL (de App ID discovery)
APP_ID_OAUTH_SERVER_URL=https://us-south.appid.cloud.ibm.com/oauth/v4/<TENANT_ID>
APP_ID_TENANT_ID=<TENANT_ID>
# Client credentials (de App ID → Applications → coope-portal)
APP_ID_CLIENT_ID=<REDACTED>
APP_ID_CLIENT_SECRET=<REDACTED>
# Callback URI — DEBE coincidir exacto con el registrado en App ID
APP_ID_REDIRECT_URI=https://coop-api.2dfzriph4wl8.us-south.codeengine.appdomain.cloud/api/auth/verify/callback
# CSRF state signing secret (random 32+ bytes)
STATE_SECRET=<REDACTED>

# ─── DB2 (dataapi) ─────────────────────────────────────────────────────────
DB2_HOST=<REDACTED>
DB2_PORT=50000
DB2_USER=<REDACTED>
DB2_PASSWORD=<REDACTED>
DB2_DATABASE=<REDACTED>
DB2_SCHEMA=<REDACTED>

# ─── Data API ──────────────────────────────────────────────────────────────
DATAAPI_URL=https://coop-dataapi.2dfzriph4wl8.us-south.codeengine.appdomain.cloud
DATAAPI_ENABLED=true
DATAAPI_TIMEOUT_MS=5000
# Tope de filas al listar TODOS los socios para el envío masivo de anuncios/
# proveedores (evita el límite por defecto de LoopBack). Subir si crece el padrón.
DATAAPI_LIST_LIMIT=10000

# ─── Portal ────────────────────────────────────────────────────────────────
JWT_SECRET=<REDACTED>
ADMIN_USER=admin
ADMIN_PASSWORD=<REDACTED>
ALLOWED_ORIGIN=https://coop-frontend.2dfzriph4wl8.us-south.codeengine.appdomain.cloud
FRONTEND_URL=https://coop-frontend.2dfzriph4wl8.us-south.codeengine.appdomain.cloud
PORT=8080

# ─── SMTP (notificación de anuncios a socios) ──────────────────────────────
# Al publicar un anuncio (POST /api/anuncios) se envía un correo a todos los
# socios con NOMBC2 válido. Si falta config, el anuncio se publica igual y el
# envío se omite con un aviso en el log.
SMTP_HOST=<REDACTED>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<REDACTED>
SMTP_PASS=<REDACTED>
MAIL_FROM=Cooperativa IBM <noreply@coopibm.pe>
