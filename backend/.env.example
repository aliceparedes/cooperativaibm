PORT=8080

# Admin login
ADMIN_USER=admin
# Recommended: generate with `npm run hash-password -- "your-password"` and paste the result here.
ADMIN_PASSWORD_HASH=
# Alternative for quick local testing only (plaintext, less secure) — used if ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=changeme

# Long random string used to sign login sessions (JWTs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Restrict which site is allowed to call this API (your GitHub Pages URL / custom domain).
# Use * only for local testing.
ALLOWED_ORIGIN=*

# --- Db2 read (dataapi) ---
# URL base del dataapi (LoopBack). P. ej. https://mi-dataapi.example.com
DATAAPI_URL=
# true = db2 es la fuente autoritativa de lectura de socios (cutover, Fase D).
# false = el portal lee del mirror local. Se enciende cuando José confirme la carga.
DATAAPI_ENABLED=false
# Timeout de cada llamada al dataapi, en ms.
DATAAPI_TIMEOUT_MS=5000

# Storage backend: "file" for local/dev, "cloudant" for IBM Cloud production.
STORAGE=file
# Only used when STORAGE=file
DATA_FILE=./data.json

# --- Only needed when STORAGE=cloudant ---
# These follow the IBM Cloud SDK's standard env-var convention (service name CLOUDANT).
# CLOUDANT_URL=https://xxxxxxxx.cloudantnosqldb.appdomain.cloud
# CLOUDANT_APIKEY=xxxxxxxx
# CLOUDANT_AUTH_TYPE=IAM
# CLOUDANT_DB=cooperativa-ibm
